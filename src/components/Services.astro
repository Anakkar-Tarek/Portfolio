---
import { serviceArrowSvg, services } from "../data/services";
---
<section id="services" class="lux-section lux-section--services">
  <div class="orb orb-b services-orb"></div>
  <div class="container">
    <div class="services-header">
      <div class="section-label">What I Do</div>
      <h2 class="section-title">Services</h2>
      <p class="services-intro">A focused set of services to help brands communicate better, look stronger online, and grow with intention.</p>
    </div>
    <div class="services-grid" id="servicesGrid">
      {services.map(s => (
        <article class="service-card" data-tilt>
          <div class="service-tag">{s.badge}</div>
          <div class="service-icon" set:html={s.icon} />
          <h3 class="service-title">{s.title}</h3>
          <p>{s.desc}</p>
          <div class="service-arrow" set:html={serviceArrowSvg} />
        </article>
      ))}
    </div>
  </div>
</section>
