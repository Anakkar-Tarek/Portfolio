---
import { currencies } from "../data/contactOptions";
import { DEFAULT_PHONE_CODE, DEFAULT_PHONE_CODE_NAME, PHONE_CODES, flagUrl } from "../data/phoneCodes";
import { serviceInquiryOptions } from "../data/services";

const DEFAULT_CURRENCY_CODE = "USD";
const DEFAULT_CURRENCY = currencies.find(({ code }) => code === DEFAULT_CURRENCY_CODE) ?? currencies[0];
---
<section id="contact" class="lux-section lux-section--return">
  <div class="orb orb-a contact-orb"></div>
  <div class="container">
    <div class="contact-grid">
      <div class="contact-left">
        <div class="section-label">Get in Touch</div>
        <h2 class="section-title">Let's Build <em>Something</em></h2>
        <p class="contact-tagline">Ready to strengthen your brand's digital presence? Tell me about your project — I respond within 24 hours.</p>
        <div class="contact-links">
          <a href="mailto:badihfadoua@gmail.com" class="contact-link">
            <div class="contact-link-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <div class="contact-link-label">Email</div>
              <div class="contact-link-val">badihfadoua@gmail.com</div>
            </div>
            <div class="contact-link-arrow">→</div>
          </a>
          <a href="https://instagram.com/bfadoua001" target="_blank" rel="noopener" class="contact-link">
            <div class="contact-link-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </div>
            <div>
              <div class="contact-link-label">Instagram</div>
              <div class="contact-link-val">@bfadoua001</div>
            </div>
            <div class="contact-link-arrow">→</div>
          </a>
          <a href="https://www.linkedin.com/in/fadoua-badih-721a371bb/" target="_blank" rel="noopener" class="contact-link">
            <div class="contact-link-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </div>
            <div>
              <div class="contact-link-label">LinkedIn</div>
              <div class="contact-link-val">Fadoua Badih</div>
            </div>
            <div class="contact-link-arrow">→</div>
          </a>
        </div>
      </div>

      <div class="contact-form-panel">
        <div class="form-header">
          <h3>Send a Message</h3>
          <p>Required fields marked with *</p>
        </div>

        <div id="formSuccess" class="form-success" aria-live="polite" hidden>
          <div class="form-success-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h4>Message received!</h4>
          <p>Thanks for reaching out. I'll get back to you within 24 hours.</p>
        </div>

        <form id="contactForm" name="contact" method="POST" action="/" data-netlify="true" netlify-honeypot="bot-field" novalidate>
          <input type="hidden" name="form-name" value="contact" />
          <input type="text" name="bot-field" tabindex="-1" autocomplete="off" style="position:absolute; left:-9999px;" />
          <div class="form-row">
            <div class="form-field">
              <label for="fname">Your Name *</label>
              <input
                type="text"
                id="fname"
                name="name"
                placeholder="Sara Alaoui"
                autocomplete="name"
                minlength="2"
                maxlength="80"
                autocapitalize="words"
                spellcheck="false"
                required
              />
              <span class="field-error" id="err-name"></span>
            </div>
            <div class="form-field">
              <label for="fphone">WhatsApp Phone Number *</label>
              <div class="field-combo phone-field-combo">
                <div class="combo-select-wrap phone-code-wrap">
                  <select id="fphoneCode" name="phoneCode" class="phone-code-native" aria-label="Country phone code" required>
                    {PHONE_CODES.map(({ iso, name, code }) => (
                      <option
                        value={code}
                        data-iso={iso}
                        data-code={code}
                        data-name={name}
                        selected={name === DEFAULT_PHONE_CODE_NAME}
                      >
                        {name} {code}
                      </option>
                    ))}
                  </select>
                  <input type="hidden" id="fphoneCountry" name="phoneCountry" value={DEFAULT_PHONE_CODE.name} />
                  <button
                    type="button"
                    class="phone-code-button"
                    id="phoneCodeButton"
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    aria-controls="phoneCodeList"
                  >
                    <img
                      id="phoneCodeFlag"
                      class="phone-flag"
                      src={DEFAULT_PHONE_CODE.flagSrc}
                      srcset={`${flagUrl(DEFAULT_PHONE_CODE.iso, 40)} 1x, ${flagUrl(DEFAULT_PHONE_CODE.iso, 80)} 2x`}
                      width="24"
                      height="18"
                      alt=""
                      loading="eager"
                      decoding="async"
                      referrerpolicy="no-referrer"
                    />
                    <span id="phoneCodeText" class="phone-code-text">{DEFAULT_PHONE_CODE.code}</span>
                  </button>
                  <span class="select-arrow combo-select-arrow phone-code-arrow"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
                  <div class="phone-code-list" id="phoneCodeList" role="listbox" hidden>
                    {PHONE_CODES.map(({ iso, name, code, flagSrc }) => (
                      <button
                        type="button"
                        class="phone-code-option"
                        data-phone-option
                        data-iso={iso}
                        data-code={code}
                        data-name={name}
                        data-flag-src={flagSrc}
                        role="option"
                        aria-selected={name === DEFAULT_PHONE_CODE_NAME ? "true" : "false"}
                      >
                        <img
                          class="phone-option-flag"
                          src={flagSrc}
                          srcset={`${flagUrl(iso, 40)} 1x, ${flagUrl(iso, 80)} 2x`}
                          width="24"
                          height="18"
                          alt=""
                          loading="lazy"
                          decoding="async"
                          referrerpolicy="no-referrer"
                        />
                        <span class="phone-option-name">{name}</span>
                        <span class="phone-option-code">{code}</span>
                      </button>
                    ))}
                  </div>
                </div>
                <input
                  type="tel"
                  id="fphone"
                  name="phone"
                  placeholder="123456789"
                  autocomplete="tel-national"
                  inputmode="tel"
                  minlength="5"
                  maxlength="20"
                  data-max-digits="15"
                  pattern="[0-9+() .-]{5,20}"
                  required
                />
              </div>
              
              <span class="field-error" id="err-phone"></span>
            </div>
          </div>
          <div class="form-row">
            <div class="form-field">
            <label for="fservice">Service Interested In *</label>
            <div class="select-wrap">
              <select id="fservice" name="service" required>
                <option value="" disabled selected>Choose a service…</option>
                {serviceInquiryOptions.map((option) => (
                  <option>{option}</option>
                ))}
              </select>
              <span class="select-arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
            </div>
            <span class="field-error" id="err-service"></span>
          </div>
            <div class="form-field">
            <label for="fbudget">Budget</label>
            <div class="field-combo budget-field-combo">
              <div class="combo-select-wrap currency-wrap">
                <select id="fcurrency" name="currency" class="currency-native" aria-label="Budget currency">
                  {currencies.map(({ code, label, name, flagIso }) => (
                    <option
                      value={code}
                      data-code={code}
                      data-label={label}
                      data-name={name}
                      data-iso={flagIso}
                      selected={code === DEFAULT_CURRENCY.code}
                    >
                      {label}
                    </option>
                  ))}
                </select>
                <button
                  type="button"
                  class="currency-button"
                  id="currencyButton"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-controls="currencyList"
                >
                  <img
                    id="currencyFlag"
                    class="currency-flag"
                    src={DEFAULT_CURRENCY.flagSrc}
                    srcset={`${flagUrl(DEFAULT_CURRENCY.flagIso, 40)} 1x, ${flagUrl(DEFAULT_CURRENCY.flagIso, 80)} 2x`}
                    width="24"
                    height="18"
                    alt=""
                    loading="eager"
                    decoding="async"
                    referrerpolicy="no-referrer"
                  />
                  <span id="currencyText" class="currency-text">{DEFAULT_CURRENCY.label}</span>
                </button>
                <span class="select-arrow combo-select-arrow currency-arrow"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
                <div class="currency-list" id="currencyList" role="listbox" hidden>
                  {currencies.map(({ code, label, name, flagIso, flagSrc }) => (
                    <button
                      type="button"
                      class="currency-option"
                      data-currency-option
                      data-code={code}
                      data-label={label}
                      data-name={name}
                      data-iso={flagIso}
                      data-flag-src={flagSrc}
                      role="option"
                      aria-label={`${name} ${label}`}
                      aria-selected={code === DEFAULT_CURRENCY.code ? "true" : "false"}
                    >
                      <img
                        class="currency-option-flag"
                        src={flagSrc}
                        srcset={`${flagUrl(flagIso, 40)} 1x, ${flagUrl(flagIso, 80)} 2x`}
                        width="24"
                        height="18"
                        alt=""
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                      />
                      <span class="currency-option-text">{label}</span>
                    </button>
                  ))}
                </div>
              </div>
              <input
                type="text"
                id="fbudget"
                name="budget"
                placeholder="1500"
                inputmode="numeric"
                autocomplete="off"
                maxlength="12"
                pattern="[0-9]{0,12}"
              />
            </div>
            <span class="field-error" id="err-budget"></span>
          </div>
          </div>
          <div class="form-field">
            <label for="fmsg">Tell Me About Your Project *</label>
            <textarea
              id="fmsg"
              name="message"
              placeholder="What are your goals? What challenge are you trying to solve?"
              minlength="10"
              maxlength="500"
              spellcheck="true"
              required
            ></textarea>
            <span class="field-error" id="err-message"></span>
            <span class="char-count"><span id="charCount">0</span>/500</span>
          </div>
          <p id="formError" class="form-submit-error" aria-live="polite" hidden></p>
          <button type="submit" class="btn btn-primary btn-full" id="contactBtn">
            <span class="btn-label">Send Message</span>
            <span class="btn-loading">
              <svg class="spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" stroke-opacity="0.3"/><path d="M12 2a10 10 0 0 1 10 10"/></svg>
              Sending…
            </span>
            <svg class="btn-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
