---
const APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbydgGgJRQKkTlO6sky-Ad5lxJuNw9Rlw9WxzL86s2UayuL_7S6k99bTOZO5tFVp4v2PYA/exec";
---
<section id="contact">
  <div class="orb orb-a contact-orb"></div>
  <div class="container">
    <div class="contact-grid">
      <div class="contact-left">
        <div class="section-label">Get in Touch</div>
        <h2 class="section-title">Let's Build <em>Something</em></h2>
        <p class="contact-tagline">Ready to strengthen your brand's digital presence? Tell me about your project — I respond within 24 hours.</p>
        <div class="contact-links">
          <a href="mailto:badihfadoua@gmail.com" class="contact-link">
            <div class="contact-link-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <div class="contact-link-label">Email</div>
              <div class="contact-link-val">badihfadoua@gmail.com</div>
            </div>
            <div class="contact-link-arrow">→</div>
          </a>
          <a href="https://instagram.com/bfadoua001" target="_blank" rel="noopener" class="contact-link">
            <div class="contact-link-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </div>
            <div>
              <div class="contact-link-label">Instagram</div>
              <div class="contact-link-val">@bfadoua001</div>
            </div>
            <div class="contact-link-arrow">→</div>
          </a>
          <a href="https://www.linkedin.com/in/fadoua-badih-721a371bb/" target="_blank" rel="noopener" class="contact-link">
            <div class="contact-link-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </div>
            <div>
              <div class="contact-link-label">LinkedIn</div>
              <div class="contact-link-val">Fadoua Badih</div>
            </div>
            <div class="contact-link-arrow">→</div>
          </a>
        </div>
      </div>

      <div class="contact-form-panel">
        <div class="form-header">
          <h3>Send a Message</h3>
          <p>All fields required</p>
        </div>

        <div id="formSuccess" class="form-success" aria-live="polite" hidden>
          <div class="form-success-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h4>Message received!</h4>
          <p>Thanks for reaching out. I'll get back to you within 24 hours.</p>
        </div>

        <form id="contactForm" novalidate>
          <div class="form-row">
            <div class="form-field">
              <label for="fname">Your Name</label>
              <input type="text" id="fname" name="name" placeholder="e.g. Sara Alaoui" autocomplete="name" required />
              <span class="field-error" id="err-name"></span>
            </div>
            <div class="form-field">
              <label for="femail">Email Address</label>
              <input type="email" id="femail" name="email" placeholder="sara@example.com" autocomplete="email" required />
              <span class="field-error" id="err-email"></span>
            </div>
          </div>
          <div class="form-field">
            <label for="fservice">Service Interested In</label>
            <div class="select-wrap">
              <select id="fservice" name="service" required>
                <option value="" disabled selected>Choose a service…</option>
                <option>Digital Marketing Strategy</option>
                <option>Media Buying</option>
                <option>Videography & Photography</option>
                <option>Editing & Post-Production</option>
                <option>Website Creation</option>
                <option>Brand Storytelling</option>
                <option>Multiple / Not Sure</option>
              </select>
              <span class="select-arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
            </div>
            <span class="field-error" id="err-service"></span>
          </div>
          <div class="form-field">
            <label for="fbudget">Budget Range</label>
            <div class="select-wrap">
              <select id="fbudget" name="budget">
                <option value="" disabled selected>Select a range…</option>
                <option>Under $500</option>
                <option>$500 – $1,500</option>
                <option>$1,500 – $5,000</option>
                <option>$5,000+</option>
                <option>Open to discuss</option>
              </select>
              <span class="select-arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
            </div>
          </div>
          <div class="form-field">
            <label for="fmsg">Tell Me About Your Project</label>
            <textarea id="fmsg" name="message" placeholder="What are your goals? What challenge are you trying to solve?" required></textarea>
            <span class="field-error" id="err-message"></span>
            <span class="char-count"><span id="charCount">0</span>/500</span>
          </div>
          <button type="submit" class="btn btn-primary btn-full" id="contactBtn">
            <span class="btn-label">Send Message</span>
            <span class="btn-loading" hidden>
              <svg class="spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" stroke-opacity="0.3"/><path d="M12 2a10 10 0 0 1 10 10"/></svg>
              Sending…
            </span>
            <svg class="btn-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ APPS_SCRIPT_URL }}>
window.__APPS_SCRIPT_URL__ = APPS_SCRIPT_URL;
</script>
